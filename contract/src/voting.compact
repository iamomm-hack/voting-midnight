// Contract for Midnight Privacy-Preserving Voting DApp
// Public data: proposal title, total yes/no votes, voting state, sequence.
// Private data: voter secret key (never revealed on-chain).
// Privacy guarantees: the wallet identity and local secret remain private. A stable,
// unlinkable nullifier is disclosed to enforce one ballot per local voting identity.

pragma language_version 0.23;

import CompactStandardLibrary;

export enum VotingState {
  REGISTRATION,
  VOTING_OPEN,
  ENDED
}

export ledger state: VotingState;
export ledger proposalTitle: Bytes<32>;
export ledger yesVotes: Counter;
export ledger noVotes: Counter;
export ledger totalVoters: Counter;
export ledger sequence: Counter;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger adminKey: Bytes<32>;

constructor() {
  state = VotingState.VOTING_OPEN;
  proposalTitle = pad(32, "Gov Proposal #1");
  adminKey = disclose(adminPublicKey(localSecretKey()));
  sequence.increment(1);
}

witness localSecretKey(): Bytes<32>;

export circuit castVote(voteChoice: Boolean): [] {
  assert(state == VotingState.VOTING_OPEN, "Voting round is not open");

  const nullifier = disclose(voterNullifier(localSecretKey(), adminKey));
  assert(!usedNullifiers.member(nullifier), "This voting identity has already voted");
  usedNullifiers.insert(nullifier);
  
  // Vote choice is intentionally disclosed since it updates public tallies
  const choice = disclose(voteChoice);
  if (choice) {
    yesVotes.increment(1);
  } else {
    noVotes.increment(1);
  }
  
  totalVoters.increment(1);
  sequence.increment(1);
}

export circuit endVoting(): [] {
  assert(state == VotingState.VOTING_OPEN, "Voting is already closed");
  const callerAdminKey = disclose(adminPublicKey(localSecretKey()));
  assert(callerAdminKey == adminKey, "Only the poll administrator can end voting");
  state = VotingState.ENDED;
  sequence.increment(1);
}

export circuit voterNullifier(sk: Bytes<32>, pollId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "voting:nullifier:"), pollId, sk]);
}

export circuit adminPublicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "voting:admin:"), sk]);
}
