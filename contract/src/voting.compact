// Contract for Midnight Privacy-Preserving Voting DApp
// Public data: proposal title, total yes/no votes, voting state, sequence.
// Private data: voter secret key (never revealed on-chain).
// Privacy guarantees: Voter identity remains zero-knowledge protected via disclose().

pragma language_version 0.23;

import CompactStandardLibrary;

export enum VotingState {
  REGISTRATION,
  VOTING_OPEN,
  ENDED
}

export ledger state: VotingState;
export ledger proposalTitle: Bytes<32>;
export ledger yesVotes: Counter;
export ledger noVotes: Counter;
export ledger totalVoters: Counter;
export ledger sequence: Counter;

constructor() {
  state = VotingState.VOTING_OPEN;
  proposalTitle = pad(32, "Gov Proposal #1");
  sequence.increment(1);
}

witness localSecretKey(): Bytes<32>;

export circuit castVote(voteChoice: Boolean): [] {
  assert(state == VotingState.VOTING_OPEN, "Voting round is not open");
  
  const voterPk = disclose(voterPublicKey(localSecretKey(), sequence as Field as Bytes<32>));
  
  // Vote choice is intentionally disclosed since it updates public tallies
  const choice = disclose(voteChoice);
  if (choice) {
    yesVotes.increment(1);
  } else {
    noVotes.increment(1);
  }
  
  totalVoters.increment(1);
  sequence.increment(1);
}

export circuit endVoting(): [] {
  assert(state == VotingState.VOTING_OPEN, "Voting is already closed");
  state = VotingState.ENDED;
  sequence.increment(1);
}

export circuit voterPublicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "voting:pk:"), sequence, sk]);
}
